{
  "scopeName": "source.xpm",
  "name": "X'",
  "patterns": [
    { "include": "#types" },
    { "include": "#modifiers" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#comments" }
  ],
  "repository": {
    "types": {
      "patterns": [
        {
          "match": "\\b(dynam|int|float|long|double|char|str|struct)\\b",
          "name": "storage.type.xpm"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "\\b(static|const|func|inline|ptr)\\b",
          "name": "storage.modifier.xpm"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|while|break|continue|return)\\b",
          "name": "keyword.control.xpm"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.xpm"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+|-|\\*|/|%|\\^|&&|\\|\\||==|!=|>=|<=|->|\\+=|-=|\\*=|/=|\\^=|=|>|<|\\.|rt)",
          "name": "keyword.operator.xpm"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.xpm"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "#",
          "end": "\n",
          "name": "comment.line"
        }
      ]
    }
  }
}